datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ======================================================
// ENUMS
// ======================================================

enum ProjectStatus {
  DRAFT
  ACTIVE
  CALIBRATING
  COMPLETED
  ARCHIVED
}

enum DeviceRole {
  ANCHOR // Dispositivo fijo para referenciar límites del espacio
  PROBE // Dispositivo móvil sensor de audio / micrófono
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
}

// ======================================================
// USERS & AUTHENTICATION
// ======================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  isVerify     Boolean  @default(false) @map("is_verify")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  session  UserSession?
  projects Project[]

  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

// ======================================================
// CALIBRATION PROJECTS & SESSIONS
// ======================================================

model Project {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  name          String
  description   String?       @db.Text
  accessCode    String        @unique @default(uuid()) @map("access_code") // Token/slug para el link público de conexión
  isShareActive Boolean       @default(true) @map("is_share_active")
  status        ProjectStatus @default(DRAFT)

  // Parámetros de referencia del recinto (dimensiones estimadas en metros)
  roomWidth  Float? @map("room_width")
  roomLength Float? @map("room_length")
  roomHeight Float? @map("room_height")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices      Device[]
  measurements AudioMeasurement[]

  @@index([userId])
  @@map("projects")
}

// ======================================================
// CONNECTED DEVICES
// ======================================================

model Device {
  id                String           @id @default(uuid())
  projectId         String           @map("project_id")
  socketId          String?          @map("socket_id") // ID de sesión WebSockets activa
  browserIdentifier String           @map("browser_identifier") // UUID persistente del navegador del cliente
  deviceToken       String?          @unique @map("device_token") // Token seguro de autenticación emitido al dispositivo
  name              String? // Ej: "iPhone 15 - Ancla Frontal"
  role              DeviceRole       @default(PROBE)
  isAnchor          Boolean          @default(false) @map("is_anchor")
  status            ConnectionStatus @default(CONNECTED)

  // Metadatos de hardware del navegador
  deviceModel String? @map("device_model")
  browserInfo String? @map("browser_info")
  audioSpecs  Json?   @map("audio_specs") // Sample rate, canales, buffer, mic label

  // Coordenadas espaciales del recinto (2D o 3D dentro del plano generado por las anclas)
  positionX Float? @default(0) @map("position_x")
  positionY Float? @default(0) @map("position_y")
  positionZ Float? @default(0) @map("position_z")

  // Coordenadas geográficas GPS reales
  latitude              Float?
  longitude             Float?
  accuracy              Float?
  altitude              Float?
  hasLocationPermission Boolean   @default(false) @map("has_location_permission")
  lastLocationAt        DateTime? @map("last_location_at")
  ipAddress             String?   @map("ip_address")

  // Calibración local de ganancia si se calibra previamente contra un sonómetro patrón
  calibrationOffsetDb Float @default(0.0) @map("calibration_offset_db")

  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  joinedAt   DateTime @default(now()) @map("joined_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  measurements AudioMeasurement[]

  @@unique([projectId, browserIdentifier])
  @@index([projectId, status])
  @@index([deviceToken])
  @@map("devices")
}

// ======================================================
// AUDIO MEASUREMENTS & SNAPSHOTS
// ======================================================

model AudioMeasurement {
  id        String @id @default(uuid())
  projectId String @map("project_id")
  deviceId  String @map("device_id")

  // Valores acústicos capturados
  decibels  Float // Nivel dB SPL medido
  peakDb    Float? @map("peak_db")
  frequency Float? // Frecuencia dominante en Hz (opcional si usas FFT)

  // Coordenadas exactas en el instante de la toma
  coordX Float  @map("coord_x")
  coordY Float  @map("coord_y")
  coordZ Float? @default(0) @map("coord_z")

  recordedAt DateTime @default(now()) @map("recorded_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  device  Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([projectId, recordedAt])
  @@index([deviceId])
  @@map("audio_measurements")
}
